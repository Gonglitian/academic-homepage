---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Highlights from '../components/Highlights.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import VisitorMap from '../components/VisitorMap.astro';
---

<BaseLayout
  title="Litian Gong (龚利天) — PhD student, UC Riverside, robot learning"
  description="Litian Gong (龚利天) is a PhD student at UC Riverside working on robot learning, imitation learning, and embodied AI with Prof. Jiachen Li."
>
  <div class="homepage">
  <Header />

  <!-- Intro -->
  <section class="intro" style="margin-bottom:32px;">
    <p>
      Hi there! I am Litian Gong (龚利天), a Ph.D. student in Electrical Engineering at the
      <a href="https://www.ucr.edu/">University of California, Riverside</a>
      (Sep 2026 – present), advised by
      <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      I am a member of the
      <a href="https://tasl.ucr.edu/">Trustworthy Autonomous Systems Lab (TASL)</a>.
    </p>
    <p>
      I am also a student research intern at the
      <a href="https://liralab.usc.edu/">Learning and Interactive Robot Autonomy Lab (LIRA)</a> at USC,
      working with <a href="https://ebiyik.github.io/">Prof. Erdem B&#305;y&#305;k</a>.
    </p>
    <p>
      I completed my M.S. in Electrical Engineering at UC Riverside and received my B.E. in
      Electrical Engineering from
      <a href="https://english.hust.edu.cn/">Huazhong University of Science and Technology (HUST)</a>,
      where I worked with <a href="http://en.seee.hust.edu.cn/info/1057/1336.htm">Prof. Shaorong Wang</a>.
    </p>
    <p>
      My research focuses on building <strong>embodied intelligent agents</strong> that learn robust, generalizable behaviors from data and interaction.
      I work at the intersection of <strong>scalable robot learning frameworks</strong>, <strong>imitation and reinforcement learning</strong>, and <strong>visual-language models</strong> for long-horizon decision making.
      My goal is to enable agents to reason over multimodal observations, acquire manipulation and navigation skills efficiently, bridge the sim-to-real gap for real-world autonomous systems, and develop data-efficient, generalizable learning algorithms.
    </p>
  </section>

  <Highlights />

  <!-- News -->
  <section style="margin-bottom:32px;">
    <h2 class="noselect">News</h2>
    <ul class="news" id="news-list">
      <li>
        <time>2026 Sep</time>
        <span>One paper accepted to <b>CoRL 2026</b>: <a href="https://pacer-corl.github.io/">PACER: Process-Aware VLA Policy Learning from Human Corrections for Robotic Disassembly</a>.</span>
      </li>
      <li>
        <time>2026 Sep</time>
        <span>Started the Ph.D. program in Electrical Engineering at UC Riverside, advised by <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.</span>
      </li>
      <li>
        <time>2026 Feb</time>
        <span>One paper accepted to <b>CVPR 2026</b>: <a href="https://arxiv.org/abs/2509.15695">ORIC: Benchmarking Object Recognition in Incongruous Context for Large Vision-Language Models</a>.</span>
      </li>
      <li class="news-extra" hidden>
        <time>2026 Jan</time>
        <span>One paper accepted to <b>ICRA 2026</b>: <a href="https://arxiv.org/abs/2511.18617">AutoFocus-IL: VLM-based Saliency Maps for Data-Efficient Visual Imitation Learning without Extra Human Annotations</a>.</span>
      </li>
      <li class="news-extra" hidden>
        <time>2025 Jun</time>
        <span>Joined the <a href="https://liralab.usc.edu/">LIRA Lab</a> at USC, working with <a href="https://ebiyik.github.io/">Prof. Erdem B&#305;y&#305;k</a>.</span>
      </li>
      <li class="news-extra" hidden>
        <time>2024 Nov</time>
        <span>Started research at <a href="https://tasl.ucr.edu/">TASL</a>, UC Riverside, working with <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.</span>
      </li>
      <li class="news-extra" hidden>
        <time>2024 Sep</time>
        <span>Started Master's program in Electrical Engineering at UC Riverside.</span>
      </li>
      <li class="news-extra" hidden>
        <time>2024 Jun</time>
        <span>Graduated from HUST as <b>Outstanding Undergraduate Graduate</b>.</span>
      </li>
    </ul>
    <button class="news-more" id="news-more" type="button" aria-expanded="false" data-label="Show all 8">Show all 8</button>
  </section>

  <!-- Education -->
  <section style="margin-bottom:32px;">
    <h2 class="noselect">Education</h2>
    <ul class="news-list" style="list-style:none;padding:0;">
      <li>
        <b>Ph.D., Electrical Engineering</b>,
        <a href="https://www.ucr.edu/">University of California, Riverside</a>
        (Sep 2026 – Present).
        Advisor: <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      </li>
      <li>
        <b>M.S., Electrical Engineering</b>,
        <a href="https://www.ucr.edu/">University of California, Riverside</a>
        (Sep 2024 – Jun 2026).
        Advisor: <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      </li>
      <li>
        <b>B.E., Electrical Engineering</b>,
        <a href="https://english.hust.edu.cn/">Huazhong University of Science and Technology (HUST)</a>
        (Sep 2020 – Jun 2024).
      </li>
    </ul>
  </section>

  <!-- Publications -->
  <Publications />

  <!-- Projects -->
  <Projects />

  <!-- Visitor map -->
  <VisitorMap />

  <!-- Footer -->
  <footer class="footer noselect">
    <p style="font-size:0.8rem;">&copy; {new Date().getFullYear()} Litian Gong</p>
  </footer>
  <script>
  const hoverOK = window.matchMedia('(hover: hover) and (pointer: fine)');
  const SCALE = 2.25;
  const MARGIN = 12;

  type Zoom = { holder: HTMLDivElement; media: HTMLElement; visual: HTMLElement; closing: boolean };
  let active: Zoom | null = null;

  function clamp(n: number, min: number, max: number) {
    return Math.min(max, Math.max(min, n));
  }

  function originFor(rect: DOMRect) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const bounds = (ox: number, oy: number) => {
      const left = rect.left + ox * rect.width * (1 - SCALE);
      const top = rect.top + oy * rect.height * (1 - SCALE);
      return { left, top, right: left + rect.width * SCALE, bottom: top + rect.height * SCALE };
    };
    let ox = 0;
    let oy = 0.5;
    let box = bounds(ox, oy);
    if (box.right > vw - MARGIN) ox = (vw - MARGIN - rect.left - rect.width * SCALE) / (rect.width * (1 - SCALE));
    box = bounds(ox, oy);
    if (box.left < MARGIN) ox = (MARGIN - rect.left) / (rect.width * (1 - SCALE));
    ox = clamp(ox, 0, 1);
    box = bounds(ox, oy);
    if (box.bottom > vh - MARGIN) oy = (vh - MARGIN - rect.top - rect.height * SCALE) / (rect.height * (1 - SCALE));
    box = bounds(ox, oy);
    if (box.top < MARGIN) oy = (MARGIN - rect.top) / (rect.height * (1 - SCALE));
    oy = clamp(oy, 0, 1);
    return { ox, oy };
  }

  function restore(zoom: Zoom) {
    if (zoom.visual.parentElement !== zoom.media) zoom.media.appendChild(zoom.visual);
    zoom.holder.remove();
    if (active === zoom) active = null;
  }

  function close(zoom: Zoom) {
    if (zoom.closing) return;
    zoom.closing = true;
    zoom.holder.style.transform = 'scale(1)';
    const done = () => restore(zoom);
    zoom.holder.addEventListener('transitionend', done, { once: true });
    window.setTimeout(done, 180);
  }

  function open(media: HTMLElement) {
    if (!hoverOK.matches) return;
    const visual = media.querySelector('img, video');
    if (!(visual instanceof HTMLElement)) return;
    if (active && !active.closing) close(active);
    const rect = media.getBoundingClientRect();
    const { ox, oy } = originFor(rect);
    const holder = document.createElement('div');
    holder.className = 'media-zoom-layer';
    holder.style.left = `${rect.left}px`;
    holder.style.top = `${rect.top}px`;
    holder.style.width = `${rect.width}px`;
    holder.style.height = `${rect.height}px`;
    holder.style.transformOrigin = `${ox * 100}% ${oy * 100}%`;
    holder.appendChild(visual);
    document.body.appendChild(holder);
    const zoom: Zoom = { holder, media, visual, closing: false };
    active = zoom;
    requestAnimationFrame(() => {
      if (active === zoom) holder.style.transform = `scale(${SCALE})`;
    });
    holder.addEventListener('mouseleave', () => close(zoom));
  }

  document.querySelectorAll<HTMLElement>('.pub-media, .hl-media').forEach((media) => {
    media.addEventListener('mouseenter', () => open(media));
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-src]');
  if (!reduceMotion && !saveData && 'IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          if (!video.getAttribute('src') && video.dataset.src) {
            video.src = video.dataset.src;
            video.load();
          }
          const pending = video.play();
          if (pending && typeof pending.catch === 'function') pending.catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      });
    }, { rootMargin: '200px 0px' });
    videos.forEach((video) => videoObserver.observe(video));
  }

  const newsMore = document.getElementById('news-more');
  if (newsMore) {
    newsMore.addEventListener('click', () => {
      const open = newsMore.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLElement>('#news-list .news-extra').forEach((item) => {
        item.hidden = open;
      });
      newsMore.setAttribute('aria-expanded', open ? 'false' : 'true');
      newsMore.textContent = open ? (newsMore.dataset.label || 'Show all') : 'Show fewer';
    });
  }

  const dismiss = () => { if (active) restore(active); };
  window.addEventListener('wheel', dismiss, { passive: true });
  window.addEventListener('touchmove', dismiss, { passive: true });
  </script>
  </div>
</BaseLayout>
