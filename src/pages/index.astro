---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Publications from '../components/Publications.astro';
import VisitorMap from '../components/VisitorMap.astro';
---

<BaseLayout
  title="Litian Gong (龚利天) — PhD student, UC Riverside, robot learning"
  description="Litian Gong (龚利天) is a PhD student at UC Riverside working on robot learning, imitation learning, and embodied AI with Prof. Jiachen Li."
>
  <div class="homepage">
  <Header />

  <!-- Intro -->
  <section class="intro" style="margin-bottom:32px;">
    <p>
      Hi there! I am Litian Gong (龚利天), a Ph.D. student in Electrical Engineering at the
      <a href="https://www.ucr.edu/">University of California, Riverside</a>
      (Sep 2026 – present), advised by
      <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      I am a member of the
      <a href="https://tasl.ucr.edu/">Trustworthy Autonomous Systems Lab (TASL)</a>.
    </p>
    <p>
      I am also a student research intern at the
      <a href="https://liralab.usc.edu/">Learning and Interactive Robot Autonomy Lab (LIRA)</a> at USC,
      working with <a href="https://ebiyik.github.io/">Prof. Erdem B&#305;y&#305;k</a>.
    </p>
    <p>
      I completed my M.S. in Electrical Engineering at UC Riverside and received my B.E. in
      Electrical Engineering from
      <a href="https://english.hust.edu.cn/">Huazhong University of Science and Technology (HUST)</a>,
      where I worked with <a href="http://en.seee.hust.edu.cn/info/1057/1336.htm">Prof. Shaorong Wang</a>.
    </p>
    <p>
      My research focuses on building <strong>embodied intelligent agents</strong> that learn robust, generalizable behaviors from data and interaction.
      I work at the intersection of <strong>scalable robot learning frameworks</strong>, <strong>imitation and reinforcement learning</strong>, and <strong>visual-language models</strong> for long-horizon decision making.
      My goal is to enable agents to reason over multimodal observations, acquire manipulation and navigation skills efficiently, bridge the sim-to-real gap for real-world autonomous systems, and develop data-efficient, generalizable learning algorithms.
    </p>
  </section>

  <!-- News -->
  <section style="margin-bottom:32px;">
    <h2 class="noselect">News</h2>
    <ul class="news-list" style="list-style:none;padding:0;">
      <li>
        <b>(2026 Sep)</b> One paper accepted to <b>CoRL 2026</b>:
        <a href="https://pacer-corl.github.io/">PACER: Process-Aware VLA Policy Learning from Human Corrections for Robotic Disassembly</a>.
      </li>
      <li>
        <b>(2026 Sep)</b> Started the Ph.D. program in Electrical Engineering at UC Riverside, advised by
        <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      </li>
      <li>
        <b>(2026 Feb)</b> One paper accepted to <b>CVPR 2026</b>:
        <a href="https://arxiv.org/abs/2509.15695">ORIC: Benchmarking Object Recognition in Incongruous Context for Large Vision-Language Models</a>.
      </li>
      <li>
        <b>(2026 Jan)</b> One paper accepted to <b>ICRA 2026</b>:
        <a href="https://arxiv.org/abs/2511.18617">AutoFocus-IL: VLM-based Saliency Maps for Data-Efficient Visual Imitation Learning without Extra Human Annotations</a>.
      </li>
      <li>
        <b>(2025 Jun)</b> Joined the <a href="https://liralab.usc.edu/">LIRA Lab</a> at USC,
        working with <a href="https://ebiyik.github.io/">Prof. Erdem B&#305;y&#305;k</a>.
      </li>
      <li>
        <b>(2024 Nov)</b> Started research at <a href="https://tasl.ucr.edu/">TASL</a>, UC Riverside,
        working with <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      </li>
      <li>
        <b>(2024 Sep)</b> Started Master's program in Electrical Engineering at UC Riverside.
      </li>
      <li>
        <b>(2024 Jun)</b> Graduated from HUST as <b>Outstanding Undergraduate Graduate</b>.
      </li>
    </ul>
  </section>

  <!-- Education -->
  <section style="margin-bottom:32px;">
    <h2 class="noselect">Education</h2>
    <ul class="news-list" style="list-style:none;padding:0;">
      <li>
        <b>Ph.D., Electrical Engineering</b>,
        <a href="https://www.ucr.edu/">University of California, Riverside</a>
        (Sep 2026 – Present).
        Advisor: <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      </li>
      <li>
        <b>M.S., Electrical Engineering</b>,
        <a href="https://www.ucr.edu/">University of California, Riverside</a>
        (Sep 2024 – Jun 2026).
        Advisor: <a href="https://jiachenli94.github.io/">Prof. Jiachen Li</a>.
      </li>
      <li>
        <b>B.E., Electrical Engineering</b>,
        <a href="https://english.hust.edu.cn/">Huazhong University of Science and Technology (HUST)</a>
        (Sep 2020 – Jun 2024).
      </li>
    </ul>
  </section>

  <!-- Publications -->
  <Publications />

  <!-- Academic Service -->
  <section style="margin-bottom:32px;">
    <h2 class="noselect">Academic Service</h2>
    <ul class="news-list" style="list-style:none;padding:0;">
      <li>
        <b>Journal Reviewer</b>:
        IEEE Robotics and Automation Letters (RA-L);
        IEEE Transactions on Robotics (T-RO).
      </li>
      <li>
        <b>Conference Reviewer</b>:
        IEEE International Conference on Robotics and Automation (ICRA), 2026;
        IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR), 2026.
      </li>
    </ul>
  </section>

  <!-- Honors -->
  <section style="margin-bottom:32px;">
    <h2 class="noselect">Honors &amp; Awards</h2>
    <ul class="news-list" style="list-style:none;padding:0;">
      <li><b>Dean's Distinguished Award</b>, UC Riverside, 2026.</li>
      <li><b>Outstanding Undergraduate Graduate</b>, HUST, 2024.</li>
    </ul>
  </section>

  <!-- Visitor map -->
  <VisitorMap />

  <!-- Footer -->
  <footer class="footer noselect">
    <p style="font-size:0.8rem;">&copy; {new Date().getFullYear()} Litian Gong</p>
  </footer>
  </div>
</BaseLayout>
