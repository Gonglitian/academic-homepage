---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={`${post.data.title} — Litian Gong`}
  description={post.data.description}
>
  <div class="blog-wrapper blog-article">
    <Header />

    <article class="blog-post">
      <h1>{post.data.title}</h1>
      <p class="article-byline">
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.tags.length > 0 && (
          <> &middot; {post.data.tags.map((t, i) => (<>{i > 0 && <span> </span>}<code>{t}</code></>))}</>
        )}
      </p>

      <section><Content /></section>
    </article>

    <footer class="footer noselect">
      <p><a href="/blog">&larr; Back to blog</a></p>
      <p style="font-size:0.8rem;">&copy; {new Date().getFullYear()} Litian Gong</p>
    </footer>
  </div>
  <script src="/toc.js" is:inline></script>
</BaseLayout>
