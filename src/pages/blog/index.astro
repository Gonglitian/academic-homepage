---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog — Litian Gong" description="Technical blog about robot learning and AI research">
  <div class="blog-wrapper blog-index">
    <Header />

    <section style="padding-top:1rem;">
      <h1>Blog</h1>

      {posts.length === 0 ? (
        <p style="color:var(--text-muted);">No posts yet. Check back soon!</p>
      ) : (
        <ul class="blog-list">
          {posts.map((post) => (
            <li>
              <span class="post-date">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
              <a class="post-title" href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
              <p class="post-desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </section>

    <footer class="footer noselect">
      <p>&copy; {new Date().getFullYear()} Litian Gong</p>
    </footer>
  </div>
</BaseLayout>
