---
import ThemeToggle from '../components/ThemeToggle.astro';

export interface Props {
  title: string;
  description?: string;
  /** BCP 47 language of the page. */
  lang?: string;
  ogType?: 'website' | 'article';
}

const { title, description, lang = 'en', ogType = 'website' } = Astro.props;
const desc = description || title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og.jpg', Astro.site).href;
const origin = Astro.site?.origin ?? 'https://litiangong.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}/#person`,
      name: 'Litian Gong',
      alternateName: '龚利天',
      jobTitle: 'PhD student',
      email: 'lgong024@ucr.edu',
      url: `${origin}/`,
      image: ogImage,
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'University of California, Riverside',
        url: 'https://www.ucr.edu/',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Huazhong University of Science and Technology',
        alternateName: 'HUST',
        url: 'https://english.hust.edu.cn/',
      },
      sameAs: [
        'https://scholar.google.com/citations?user=cirHYboAAAAJ',
        'https://github.com/gonglitian',
        'https://www.linkedin.com/in/Gonglitian/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: `${origin}/`,
      name: 'Litian Gong (龚利天)',
      description: desc,
      inLanguage: lang,
      publisher: { '@id': `${origin}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Litian Gong" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Litian Gong" />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Litian Gong (龚利天), PhD student at UC Riverside, robot learning" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="Litian Gong (龚利天), PhD student at UC Riverside, robot learning" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;700&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;700&display=swap" />
  </noscript>
  <script is:inline>
    /* no-FOUC: apply saved type-tune overrides before first paint */
    try {
      localStorage.removeItem('typetune'); /* drop stale pre-bake overrides */
      var t = JSON.parse(localStorage.getItem('typetune-v2') || '{}');
      var s = document.documentElement.style;
      for (var k in t) s.setProperty(k, t[k]);
    } catch (e) {}
  </script>
  <slot name="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <ThemeToggle />
  <slot />
  <script src="/code-copy.js" is:inline></script>
  <script src="/typetune.js" is:inline></script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
