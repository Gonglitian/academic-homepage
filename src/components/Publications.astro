};

async function loadStars(repo: string): Promise<number | null> {
  try {
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        "User-Agent": "litiangong-homepage",
        Accept: "application/vnd.github+json",
      },
    });
    if (!res.ok) return null;
    const data = await res.json();
    return typeof data.stargazers_count === "number" ? data.stargazers_count : null;
  } catch {
    return null;
  }
}

const starCount = new Map(
  await Promise.all(
    Object.entries(codeRepos).map(async ([href, repo]) => [href, await loadStars(repo)] as const),
  ),
);

function formatStars(n: number): string {
  if (n < 1000) return String(n);
  const digits = n >= 10000 ? 0 : 1;
  return `${(n / 1000).toFixed(digits).replace(/\.0$/, "")}k`;
}

const siteOrigin = "https://litiangong.com";

function plainAuthors(html: string): string[] {
  return html
    .replace(/<[^>]+>/g, "")
    .split(",")
    .map((name) => name.trim().replace(/\*+$/, ""))
    .filter(Boolean);
}

function plainText(html: string): string {
  return html.replace(/<[^>]+>/g, "").trim();
}

const publicationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": pubs.map((pub) => {
    const arxiv = pub.links.find((link) => link.label === "arXiv")?.href;
    const doi = pub.links.find((link) => link.label === "DOI")?.href;
    const project = pub.links.find((link) => link.label === "project page")?.href;
    const node: Record<string, unknown> = {
      "@type": "ScholarlyArticle",
      headline: pub.title,
      author: plainAuthors(pub.authors).map((name) =>
        name === "Litian Gong"
          ? { "@type": "Person", name, url: `${siteOrigin}/` }
          : { "@type": "Person", name },
      ),
    };
    // In-submission entries stay anonymous: no venue, publisher, or date.
    if (!pub.status) {
      node.datePublished = String(pub.year);
      const venue = plainText(pub.venue);
      if (venue) node.publisher = { "@type": "Organization", name: venue };
    }
    const url = arxiv || doi || project;
    if (url) node.url = url;
    const sameAs = [arxiv, doi, project].filter((item) => item && item !== url);
    if (sameAs.length) node.sameAs = sameAs;
    return node;
  }),
});
---

<section>
  <script type="application/ld+json" set:html={publicationJsonLd} />
  <h2 class="noselect">Publications</h2>
  <p style="color:var(--text-muted);font-size:0.9rem;margin:0 0 12px;">* Equal contribution.</p>

  <div id="publications-container">
    {pubs.map((pub) => (
      <div
        class={`publication row clearfix${pub.highlight ? ' highlighted' : ''}`}
        id={pub.id}
        data-categories={pub.categories.join(',')}
      >
        {pub.media && (
          <div class="pub-media">
            {pub.media.type === 'video' ? (
              <video
                muted
                loop
                playsinline
                preload="none"
                poster={pub.media.poster}
                data-src={pub.media.src}
                width={pub.media.width}
                height={pub.media.height}
                aria-label={pub.media.alt}
              ></video>
            ) : (
              <img src={pub.media.src} alt={pub.media.alt} width={pub.media.width} height={pub.media.height} loading="lazy" decoding="async" />
            )}
          </div>
        )}
        <div class="pub-text">
          {pub.links.length > 0 ? (
            <a class="paper-title" href={pub.links[0].href}>{pub.title}</a>
          ) : (
            <span class="paper-title">{pub.title}</span>
          )}
          <br />
          <span class="paper-authors" set:html={pub.authors} /><br />
          {pub.status ? (
            <span class="paper-venue" set:html={pub.status} />
          ) : (
            <>
              <span class="paper-venue" set:html={pub.venue} />, {pub.year}
            </>
          )}
          {pub.award && <span style="color:#f04328;font-weight:600;"> ({pub.award})</span>}
          {pub.links.length > 0 && (
            <>
              <br />
              <span class="paper-links">
                {pub.links.map((link) => {
                  const stars = link.label === "code" ? starCount.get(link.href) : null;
                  return (
                    <>
                      <a class={`btn ${link.cls || ''}`} href={link.href}>{link.label}</a>
                      {typeof stars === "number" && <span class="star-count">★ {formatStars(stars)}</span>}
                    </>
                  );
                })}
              </span>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
