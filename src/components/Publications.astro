---
interface Pub {
  title: string;
  authors: string;
  venue: string;
  year: number;
  categories: string[];
  links: { label: string; href: string; cls?: string }[];
  media?: { type: 'video'; src: string } | { type: 'image'; src: string };
  /** Shown instead of "venue, year" for manuscripts that are not yet published. */
  status?: string;
  highlight?: boolean;
  award?: string;
  equalContribution?: boolean;
}

function formatAuthors(people: { name: string; href?: string }[]): string {
  return people
    .map(({ name, href }) => {
      const star = name.endsWith("*") ? "*" : "";
      const base = star ? name.slice(0, -1) : name;
      const label = base === "Litian Gong"
        ? `<span class='bold'>Litian Gong${star}</span>`
        : `${base}${star}`;
      if (base === "Litian Gong" || !href) return label;
      return `<a href="${href}">${label}</a>`;
    })
    .join(", ");
}

