---

<section>
  <h2 class="noselect">Publications</h2>
  <p class="filter-bar">
    Filter by:
    <button class="filter-btn active" data-cat="all">All Papers</button>
    <button class="filter-btn" data-cat="selected">Selected Papers</button>
    <button class="filter-btn" data-cat="vla">Robot Learning</button>
    <button class="filter-btn" data-cat="vlm">Vision-Language</button>
    <button class="filter-btn" data-cat="other">Other Topics</button>
  </p>
  <p style="color:var(--text-muted);font-size:0.9rem;margin:-8px 0 12px;">* Equal contribution.</p>

  <div id="publications-container">
    {pubs.map((pub) => (
      <div
        class={`publication row clearfix${pub.highlight ? ' highlighted' : ''}`}
        data-categories={pub.categories.join(',')}
      >
        {pub.media && (
          <div class="pub-media" style={pub.media.type === 'image' ? `background-image:url(${pub.media.src});background-size:cover;background-position:center;` : ''}>
            {pub.media.type === 'video' && (
              <video autoplay muted loop playsinline>
                <source src={pub.media.src} type="video/mp4" />
              </video>
            )}
          </div>
        )}
        <div class="pub-text">
          {pub.links.length > 0 ? (
            <a class="paper-title" href={pub.links[0].href}>{pub.title}</a>
          ) : (
            <span class="paper-title">{pub.title}</span>
          )}
          <br />
          <span class="paper-authors" set:html={pub.authors} /><br />
          {pub.status ? (
            <span class="paper-venue" set:html={pub.status} />
          ) : (
            <>
              <span class="paper-venue" set:html={pub.venue} />, {pub.year}
            </>
          )}
          {pub.award && <span style="color:#f04328;font-weight:600;"> ({pub.award})</span>}
          {pub.links.length > 0 && (
            <>
              <br />
              <span class="paper-links">
                {pub.links.map((link) => (
                  <a class={`btn ${link.cls || ''}`} href={link.href}>{link.label}</a>
                ))}
              </span>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const pubs = document.querySelectorAll<HTMLElement>('#publications-container .publication');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = (btn as HTMLElement).dataset.cat!;

      pubs.forEach(pub => {
        const cats = pub.dataset.categories?.split(',') || [];
        pub.style.display = (cat === 'all' || cats.includes(cat)) ? '' : 'none';
      });
    });
  });
</script>
