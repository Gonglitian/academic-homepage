---
interface Pub {
  title: string;
  authors: string;
  venue: string;
  year: number;
  categories: string[];
  links: { label: string; href: string; cls?: string }[];
  media?: { type: 'video'; src: string } | { type: 'image'; src: string };
  /** Shown instead of "venue, year" for manuscripts that are not yet published. */
  status?: string;
  highlight?: boolean;
  award?: string;
  equalContribution?: boolean;
}

function formatAuthors(names: string[]): string {
  return names
    .map((name) => {
      const star = name.endsWith("*") ? "*" : "";
      const base = star ? name.slice(0, -1) : name;
      if (base === "Litian Gong") return `<span class='bold'>Litian Gong${star}</span>`;
      return name;
    })
    .join(", ");
}

