<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">Light</button>

<script>
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    const paint = (isDark: boolean) => {
      document.documentElement.classList.toggle('dark', isDark);
      toggle.textContent = isDark ? 'Dark' : 'Light';
      toggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    paint(document.documentElement.classList.contains('dark'));
    toggle.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      paint(isDark);
    });
  }
</script>
