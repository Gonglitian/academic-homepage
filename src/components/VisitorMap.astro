---
const src = "https://mapmyvisitors.com/map.js?d=bLOU-RuFfuWYkbT5lp6u0WPtxscgzA9V2SDkbHrtINo&cl=ffffff&w=a";
---

<section class="visitor-map noselect" aria-label="Visitor map">
  <h2>Visitors</h2>
  <div class="visitor-map-frame">
    <div id="visitor-map-slot" class="visitor-map-slot">
      <p class="visitor-map-fallback" hidden>Visitor map unavailable.</p>
    </div>
  </div>
</section>

<script define:vars={{ src }}>
  const section = document.querySelector('.visitor-map');
  const slot = document.getElementById('visitor-map-slot');
  const fallback = slot?.querySelector('.visitor-map-fallback');
  if (section && slot) {
    let started = false;
    const showFallback = () => {
      if (fallback instanceof HTMLElement) fallback.hidden = false;
    };
    const load = () => {
      if (started) return;
      started = true;
      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.id = 'mapmyvisitors';
      script.src = src;
      script.async = true;
      script.onerror = showFallback;
      script.onload = () => {
        let tries = 0;
        const check = () => {
          const widget = slot.querySelector('#mapmyvisitors-widget');
          const painted = widget?.querySelector('svg path, svg, canvas');
          if (painted) return;
          tries += 1;
          if (tries < 40) window.setTimeout(check, 200);
          else showFallback();
        };
        check();
      };
      slot.appendChild(script);
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        load();
        io.disconnect();
      }
    }, { rootMargin: '200px' });
    io.observe(section);
  }
</script>
