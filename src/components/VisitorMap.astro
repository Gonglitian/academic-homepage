---
/**
 * VisitorMap — a globe/map of where visitors come from, shown at the bottom of the homepage.
 *
 * NOTE: visitor tracking only works on the DEPLOYED site (a public domain), not on
 * localhost, and the embed is keyed to YOUR account. To activate:
 *   1. Sign up free at https://mapmyvisitors.com  (alt: https://www.revolvermaps2.com)
 *   2. Add your domain, then copy the widget id from the snippet they give you
 *      (it looks like:  mapmyvisitors.com/web/<ID>  /  map.png?d=<ID>&...).
 *   3. Paste that id into `widgetId` below. The placeholder is replaced automatically.
 *
 * Privacy note: this embeds a 3rd-party tracker — every visitor's IP/location is sent
 * to that service. That's exactly what this widget is for, but it's worth knowing.
 */
const widgetId = ""; // <-- paste your MapMyVisitors widget id here to go live
// Static map image params (only used once widgetId is set). Tweak colors to taste.
const mapSrc = widgetId
  ? `https://mapmyvisitors.com/map.png?d=${widgetId}&cl=ffffff&w=a`
  : "";
---

<section class="visitor-map noselect" aria-label="Visitor map">
  <h2>Visitors</h2>
  <div class="visitor-map-frame">
    {widgetId ? (
      <a href={`https://mapmyvisitors.com/web/${widgetId}`} title="Visitor map" target="_blank" rel="noopener">
        <img src={mapSrc} alt="Map of recent visitors by location" loading="lazy" />
      </a>
    ) : (
      <div class="visitor-map-placeholder">
        <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <circle cx="32" cy="32" r="26" />
          <ellipse cx="32" cy="32" rx="11" ry="26" />
          <ellipse cx="32" cy="32" rx="26" ry="11" />
          <line x1="6" y1="32" x2="58" y2="32" />
          <line x1="32" y1="6" x2="32" y2="58" />
        </svg>
        <p>A live globe of visitor locations will appear here once the site is
        deployed and the widget id is configured.</p>
      </div>
    )}
  </div>
</section>
