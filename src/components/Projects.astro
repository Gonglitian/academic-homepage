<section id="projects">
  <h2 class="noselect">Projects</h2>
  <div id="projects-container">
    {projects.map((project) => (
      <div class="publication" id={project.id}>
        <div class="pub-media">
          <video
            muted
            loop
            playsinline
            preload="none"
            poster={project.poster}
            data-src={project.src}
            width={project.width}
            height={project.height}
            aria-label={project.title}
          ></video>
        </div>
        <div class="pub-text">
          <span class="paper-title">{project.title}</span>
          <p class="project-desc">{project.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
